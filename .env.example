# Copy to .env. Keys: https://dashboard.caleralabs.com

ICX_BASE_URL=https://icx.api.caleralabs.com/v1
ICX_API_KEY=REPLACE_ME_ICX_API_KEY
ICX_SPACE_ID=local
ICX_TIMEOUT_SECONDS=60

# Gateway (generated automatically on first `serve` if unset)
# ICX_GATEWAY_TOKEN=icxgw_REPLACE_ME

# Bring Your Own Key model providers: gemini, openai, anthropic, deepseek, groq, ollama
BYOK_PROVIDER=gemini

GEMINI_API_KEY=REPLACE_ME_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# OPENAI_API_KEY=REPLACE_ME_OPENAI_API_KEY
# OPENAI_MODEL=gpt-4o-mini

# DEEPSEEK_API_KEY=REPLACE_ME_DEEPSEEK_API_KEY
# DEEPSEEK_MODEL=deepseek-chat

# BYOK_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.1
